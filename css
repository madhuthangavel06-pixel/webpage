/* ROOT CSS VARIABLES */
:root {
  --bg-dark: #0d1117;
  --bg-card: #161b22;
  --bg-light: #1c2128;
  --text-main: #f0f6fc;
  --text-muted: #8b949e;
  --accent-color: #c88d66;
  --accent-hover: #b07853;
  --border-color: #30363d;
  --font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
}

/* RESET */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  background-color: var(--bg-dark);
  color: var(--text-main);
  font-family: var(--font-family);
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

ul {
  list-style: none;
}

/* LAYOUT HELPERS */
.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.small-container {
  max-width: 600px;
}

.section {
  padding: 5rem 0;
}

.dark-bg {
  background-color: var(--bg-light);
}

.grid {
  display: grid;
  gap: 1.5rem;
}

.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

.align-center {
  align-items: center;
}

.text-center {
  text-align: center;
}

/* HEADER */
.header {
  position: sticky;
  top: 0;
  background-color: rgba(13, 17, 23, 0.9);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border-color);
  z-index: 100;
  padding: 1rem 0;
}

.header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.brand-icon {
  width: 40px;
  height: 40px;
  background: var(--bg-card);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-color);
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-weight: 700;
  font-size: 1.1rem;
}

.brand-subtitle {
  font-size: 0.75rem;
  color: var(--text-muted);
}

/* BUTTONS */
.btn-primary {
  background-color: var(--accent-color);
  color: #fff;
  padding: 0.65rem 1.4rem;
  border-radius: 20px;
  font-weight: 600;
  border: none;
  cursor: pointer;
  display: inline-block;
  transition: background 0.2s;
}

.btn-primary:hover {
  background-color: var(--accent-hover);
}

.btn-outline {
  border: 1px solid var(--border-color);
  color: var(--text-main);
  padding: 0.65rem 1.4rem;
  border-radius: 20px;
  font-weight: 600;
  display: inline-block;
  transition: border-color 0.2s;
}

.btn-outline:hover {
  border-color: var(--text-main);
}

/* HERO SECTION */
.hero {
  padding: 4rem 0;
  text-align: center;
}

.hero-badge {
  color: var(--accent-color);
  text-transform: uppercase;
  font-size: 0.8rem;
  letter-spacing: 2px;
  font-weight: 600;
}

.hero-title {
  font-size: 2.8rem;
  margin: 0.75rem 0;
}

.hero-desc {
  max-width: 650px;
  margin: 0 auto 2rem;
  color: var(--text-muted);
  font-size: 1.1rem;
}

.hero-buttons {
  display: flex;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 3rem;
}

.hero-image-wrapper {
  display: flex;
  justify-content: center;
}

.hero-img {
  width: 320px;
  height: 320px;
  border-radius: 50%;
  object-fit: cover;
  border: 4px solid var(--bg-card);
}

/* SECTION TITLES */
.section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.section-title {
  font-size: 2rem;
  margin-bottom: 0.5rem;
}

.section-title.left-align {
  text-align: left;
}

.section-subtitle {
  color: var(--text-muted);
}

.category-title {
  font-size: 1.4rem;
  margin-top: 2rem;
}

.category-subtitle {
  color: var(--text-muted);
  font-size: 0.9rem;
  margin-bottom: 1.5rem;
}

/* CARDS */
.card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 1.5rem;
  position: relative;
}

.card-popular {
  border-color: var(--accent-color);
}

.badge {
  position: absolute;
  top: -12px;
  right: 15px;
  background-color: var(--accent-color);
  color: #fff;
  font-size: 0.7rem;
  padding: 2px 10px;
  border-radius: 10px;
  text-transform: uppercase;
  font-weight: bold;
}

.card-header-row, .card-footer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
}

.card-footer-row {
  margin-top: 1rem;
  margin-bottom: 0;
}

.price {
  font-weight: bold;
  color: var(--accent-color);
}

.tags {
  margin-top: 1rem;
  display: flex;
  gap: 0.5rem;
}

.tags span {
  background: var(--bg-dark);
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 0.75rem;
  color: var(--text-muted);
}

/* STATS */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}

.stat-box {
  background-color: var(--bg-card);
  padding: 1.5rem;
  border-radius: 8px;
  text-align: center;
  border: 1px solid var(--border-color);
}

.stat-num {
  display: block;
  font-size: 2rem;
  font-weight: bold;
  color: var(--accent-color);
}

.stat-label {
  font-size: 0.85rem;
  color: var(--text-muted);
}

/* PROCESS STEPS */
.step-card {
  background: var(--bg-dark);
  padding: 1.5rem;
  border-radius: 8px;
  border: 1px solid var(--border-color);
}

.step-num {
  font-size: 0.75rem;
  color: var(--accent-color);
  font-weight: bold;
  text-transform: uppercase;
}

.step-card h4 {
  margin: 0.5rem 0;
}

.step-card p {
  font-size: 0.9rem;
  color: var(--text-muted);
}

/* NEWSLETTER */
.newsletter-form {
  display: flex;
  gap: 0.5rem;
  margin-top: 1.5rem;
  justify-content: center;
}

.newsletter-form input {
  padding: 0.65rem 1rem;
  border-radius: 20px;
  border: 1px solid var(--border-color);
  background-color: var(--bg-dark);
  color: var(--text-main);
  width: 100%;
  max-width: 320px;
}

/* FOOTER */
.footer {
  background-color: var(--bg-dark);
  padding: 4rem 0 2rem;
  border-top: 1px solid var(--border-color);
  font-size: 0.9rem;
}

.footer h5 {
  margin-bottom: 1rem;
}

.footer p, .footer li {
  color: var(--text-muted);
  margin-bottom: 0.4rem;
}

.footer-bottom {
  text-align: center;
  margin-top: 3rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--border-color);
  color: var(--text-muted);
}

/* RESPONSIVE DESIGN */
@media (max-width: 768px) {
  .grid-2, .grid-3, .grid-4 {
    grid-template-columns: 1fr;
  }

  .newsletter-form {
    flex-direction: column;
    align-items: center;
  }

  .hero-title {
    font-size: 2.1rem;
  }
}
