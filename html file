<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Roast & Co. — Specialty Coffee Roasters</title>
  <link rel="stylesheet" href="website.css">
</head>
<body>

  <!-- HEADER / NAVIGATION -->
  <header class="header">
    <div class="header-container">
      <a href="#" class="brand">
        <div class="brand-icon">☕</div>
        <div class="brand-text">
          <span class="brand-title">Roast & Co.</span>
          <span class="brand-subtitle">Specialty Coffee Roasters</span>
        </div>
      </a>
      <div class="nav-right">
        <a href="#shop" class="btn-primary">Order Online</a>
      </div>
    </div>
  </header>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="container hero-content">
      <span class="hero-badge">Specialty Coffee Roasters</span>
      <h1 class="hero-title">Crafted with Passion & Precision</h1>
      <p class="hero-desc">
        From bean to cup, we obsess over every detail. Experience specialty coffee the way it was meant to be — fresh-roasted, expertly brewed, and served with care.
      </p>
      <div class="hero-buttons">
        <a href="#menu" class="btn-primary">View Our Menu</a>
        <a href="#shop" class="btn-outline">Order Online</a>
      </div>
      <div class="hero-image-wrapper">
        <img src="https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=800&q=80" alt="Specialty Coffee" class="hero-img">
      </div>
    </div>
  </section>

  <!-- MENU SECTION -->
  <section id="menu" class="section dark-bg">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Our Menu</h2>
        <p class="section-subtitle">Handcrafted drinks and fresh-baked goods, made with love</p>
      </div>

      <!-- Espresso Category -->
      <h3 class="category-title">Espresso Drinks</h3>
      <p class="category-subtitle">Crafted with our signature house blend</p>
      <div class="grid grid-3">
        <div class="card">
          <div class="card-body">
            <div class="card-header-row">
              <h4>Espresso</h4>
              <span class="price">$3.50</span>
            </div>
            <p>Rich, bold, and perfectly extracted</p>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <div class="card-header-row">
              <h4>Cortado</h4>
              <span class="price">$4.50</span>
            </div>
            <p>Equal parts espresso and steamed milk</p>
          </div>
        </div>
        <div class="card card-popular">
          <span class="badge">Popular</span>
          <div class="card-body">
            <div class="card-header-row">
              <h4>Cappuccino</h4>
              <span class="price">$5.00</span>
            </div>
            <p>Velvety foam with a double shot</p>
          </div>
        </div>
      </div>

      <!-- Pour Overs Category -->
      <h3 class="category-title">Pour Overs</h3>
      <p class="category-subtitle">Single-origin beans, brewed to order</p>
      <div class="grid grid-3">
        <div class="card">
          <div class="card-body">
            <div class="card-header-row">
              <h4>Ethiopian Yirgacheffe</h4>
              <span class="price">$6.00</span>
            </div>
            <p>Floral, citrus, and tea-like</p>
            <div class="tags">
              <span>Bergamot</span><span>Jasmine</span><span>Lemon</span>
            </div>
          </div>
        </div>
        <div class="card card-popular">
          <span class="badge">Popular</span>
          <div class="card-body">
            <div class="card-header-row">
              <h4>Colombian Huila</h4>
              <span class="price">$5.50</span>
            </div>
            <p>Caramel, red apple, and milk chocolate</p>
            <div class="tags">
              <span>Caramel</span><span>Apple</span><span>Chocolate</span>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <div class="card-header-row">
              <h4>Guatemalan Antigua</h4>
              <span class="price">$5.50</span>
            </div>
            <p>Smoky, cocoa, and spice</p>
            <div class="tags">
              <span>Cocoa</span><span>Smoke</span><span>Spice</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STORY / STATS SECTION -->
  <section class="section">
    <div class="container grid grid-2 align-center">
      <div>
        <h2 class="section-title left-align">From Portland, With Love</h2>
        <p class="text-block">
          What started as a small cart at the Saturday Market has grown into three beloved locations across Portland. But our mission remains the same: to source exceptional coffees, roast them with care, and share them with our community.
        </p>
        <p class="text-block">
          Every bag we roast tells a story — of the farmers who grew it, the land that nurtured it, and the hands that brought it to your cup.
        </p>
      </div>
      <div class="stats-grid">
        <div class="stat-box">
          <span class="stat-num">15+</span>
          <span class="stat-label">Years Roasting</span>
        </div>
        <div class="stat-box">
          <span class="stat-num">12</span>
          <span class="stat-label">Origin Countries</span>
        </div>
        <div class="stat-box">
          <span class="stat-num">3</span>
          <span class="stat-label">Locations</span>
        </div>
        <div class="stat-box">
          <span class="stat-num">50k+</span>
          <span class="stat-label">Happy Customers</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS SECTION -->
  <section class="section dark-bg">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">From Origin to Cup</h2>
        <p class="section-subtitle">Our commitment to quality at every step</p>
      </div>
      <div class="grid grid-4">
        <div class="step-card">
          <span class="step-num">Step 01</span>
          <h4>Sourcing</h4>
          <p>Direct partnerships with farmers across the coffee belt ensuring fair prices.</p>
        </div>
        <div class="step-card">
          <span class="step-num">Step 02</span>
          <h4>Roasting</h4>
          <p>Small-batch roasting in Portland to bring out full flavor profiles.</p>
        </div>
        <div class="step-card">
          <span class="step-num">Step 03</span>
          <h4>Cupping</h4>
          <p>Daily quality testing and tasting sessions to maintain consistency.</p>
        </div>
        <div class="step-card">
          <span class="step-num">Step 04</span>
          <h4>Serving</h4>
          <p>Expertly brewed and served with precision by our baristas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SHOP BEANS SECTION -->
  <section id="shop" class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Take It Home</h2>
        <p class="section-subtitle">Fresh-roasted beans delivered to your door</p>
      </div>
      <div class="grid grid-3">
        <div class="card card-popular">
          <span class="badge">Bestseller</span>
          <div class="card-body">
            <h4>House Blend</h4>
            <p>Notes of chocolate, caramel, and toasted nuts.</p>
            <div class="card-footer-row">
              <span class="price">$18.00 <small>/ 12oz</small></span>
              <button class="btn-primary">Add to Cart</button>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <h4>Single Origin - Ethiopia</h4>
            <p>Light roast with bright citrus and floral notes.</p>
            <div class="card-footer-row">
              <span class="price">$22.00 <small>/ 12oz</small></span>
              <button class="btn-primary">Add to Cart</button>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <h4>Decaf Blend</h4>
            <p>All the flavor, none of the caffeine buzz.</p>
            <div class="card-footer-row">
              <span class="price">$19.00 <small>/ 12oz</small></span>
              <button class="btn-primary">Add to Cart</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER SECTION -->
  <section class="section dark-bg text-center">
    <div class="container small-container">
      <h2 class="section-title">Join the Club</h2>
      <p class="section-subtitle">Get exclusive offers, brewing tips, and 10% off your first order.</p>
      <form class="newsletter-form" action="#" method="POST">
        <input type="email" placeholder="Enter your email address" required>
        <button type="submit" class="btn-primary">Subscribe</button>
      </form>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container grid grid-4">
      <div>
        <div class="brand">
          <div class="brand-title">Roast & Co.</div>
        </div>
        <p class="footer-desc">Artisan coffee roasters dedicated to serving the finest specialty coffees from around the world.</p>
      </div>
      <div>
        <h5>Menu</h5>
        <ul>
          <li><a href="#menu">Espresso Drinks</a></li>
          <li><a href="#menu">Pour Overs</a></li>
          <li><a href="#menu">Cold Drinks</a></li>
        </ul>
      </div>
      <div>
        <h5>Hours</h5>
        <p>Mon - Fri: 7am - 7pm</p>
        <p>Sat - Sun: 8am - 6pm</p>
      </div>
      <div>
        <h5>Contact</h5>
        <p>hello@roastandco.com</p>
        <p>(555) 234-5678</p>
        <p>123 Roastery Lane, Portland, OR</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 Roast & Co. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>
